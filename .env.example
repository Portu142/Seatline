# Copy to .env and adjust. Never commit .env.
# Every value below has a local default in docker-compose.yml, so .env is optional for local dev.

# PostgreSQL (local container)
POSTGRES_DB=seatline
POSTGRES_USER=seatline
POSTGRES_PASSWORD=change-me

# Host ports (change them if something else on your machine already uses them)
DB_PORT=5433
WEB_PORT=4173

# JWT signing key: at least 32 random characters. Generate one with:
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# Password for the seeded demo accounts (customer@, admin@, validator@seatline.dev)
DEMO_PASSWORD=

# --- Production (Render / Railway / Fly.io) uses the ASP.NET Core names directly ---
# ConnectionStrings__Default=postgresql://user:password@host:5432/seatline?sslmode=require
# Jwt__SigningKey=
# Seed__DemoUsers=true
# Seed__DemoPassword=
# Cors__AllowedOrigins__0=https://your-web.vercel.app

# --- Web (Vite, build time) ---
# VITE_API_URL=http://localhost:8080
