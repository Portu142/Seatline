{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "seatline-api",
    "Audience": "seatline-web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Seed": {
    "DemoUsers": false,
    "DemoPassword": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Swagger": {
    "Enabled": true
  },
  "RateLimiting": {
    "AuthRequestsPerMinute": 20
  }
}
